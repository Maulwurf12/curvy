### Ungültiger Wunschwert (erwartet HTTP 400)
POST {{baseUrl}}/api/routes
Content-Type: application/json
Accept: application/json, application/problem+json

{
  "start": {"latitude": 47.678, "longitude": 9.173},
  "destination": {"latitude": 47.566, "longitude": 10.700},
  "targetScore": 101
}

> {%
    client.test("Wunschwert über 100 wird abgelehnt", function () {
        client.assert(response.status === 400, "Erwartet HTTP 400");
    });
%}
